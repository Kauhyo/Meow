ss multiple channels, including threshold, make-up gain, and ratio, were extracted from their corresponding offsets within the data. Channel routing data reveals gain values and pre-fader assignments for aux channels and master fader assignments. Surface layer configuration, particularly for strips 0-8, provides specific channel assignments for various inputs and outputs, with some strips left blank.\n\n\n","tool_calls":[{"name":"run_command","args":{"CommandLine":"$code = @\"\nusing System;\nusing System.IO;\nusing System.Text;\n\npublic class SqShowBuilder {\n    static void WriteU16(byte[] buf, int offset, ushort val) {\n        buf[offset] = (byte)(val & 0xFF);\n        buf[offset + 1] = (byte)((val >> 8) & 0xFF);\n    }\n\n    static void SetNameAndColor(byte[] buf, int ch, string name, byte color) {\n        int baseOff = 0x0374 + ch * 0x150;\n        for (int i = 0; i < 7; i++) buf[baseOff + i] = 0;\n        byte[] ascii = Encoding.ASCII.GetBytes(name);\n        int len = Math.Min(ascii.Length, 6);\n        Array.Copy(ascii, 0, buf, baseOff, len);\n        buf[baseOff + 0x0C] = color;\n    }\n\n    static void SetRoute(byte[] buf, int ch, int routeIdx, ushort level, ushort pan, byte flags) {\n        int off = 0xA9A0 + ch * 300 + routeIdx * 6;\n        WriteU16(buf, off, level);\n        WriteU16(buf, off + 2, pan);\n        buf[off + 4] = flags;\n        buf[off + 5] = 0xFF;\n    }\n\n    static void SetPeqBand(byte[] buf, int ch, int bandIdx, ushort gain, ushort freq, byte width, byte type) {\n        int off = 0x0374 + ch * 0x150 + 0x07C + bandIdx * 6;\n        WriteU16(buf, off, gain);\n        WriteU16(buf, off + 2, freq);\n        buf[off + 4] = width;\n        buf[off + 5] = type;\n    }\n\n    public static void Build(string templatePath, string exePath, string[] outputDirs) {\n        byte[] buf = File.ReadAllBytes(templatePath);\n        if (buf.Length != 0x20000) throw new Exception(\"Invalid template size\");\n\n        // 1. Configure Channels 0, 1, 2 (Voix 1, Voix 2, Voix 3)\n        string[] vocalNames = { \"Voix 1\", \"Voix 2\", \"Voix 3\" };\n        byte[] vocalColors = { 1, 2, 5 }; // Red, Yellow, Blue\n\n        for (int ch = 0; ch < 3; ch++) {\n            int baseOff = 0x0374 + ch * 0x150;\n            SetNameAndColor(buf, ch, vocalNames[ch], vocalColors[ch]);\n\n            // Preamp Gain (+28 dB = 0x0064 default)\n            WriteU16(buf, baseOff + 0x034, 0x0064);\n\n            // HPF: ~90 Hz (0x37BA), HPF ON (+0x057 = 1)\n            WriteU16(buf, baseOff + 0x054, 0x37BA);\n            buf[baseOff + 0x057] = 0x01;\n\n            // Gate: Threshold -42 dB (0x5600), Depth 12 dB (0x8C00), Gate ON (+0x076 = 1)\n            WriteU16(buf, baseOff + 0x062, 0x5600);\n            WriteU16(buf, baseOff + 0x064, 0x8C00);\n            buf[baseOff + 0x076] = 0x01;\n\n            // PEQ: 4-band Vocal EQ, PEQ ON (+0x0AD = 1)\n            // Band 0 (LF): -3.0 dB (0x7D00) @ 200 Hz (0x5555), Width 0x10, Bell (0)\n            SetPeqBand(buf, ch, 0, 0x7D00, 0x5555, 0x10, 0x00);\n            // Band 1 (LM): -2.5 dB (0x7D80) @ 450 Hz (0x7366), Width 0x0A (narrow), Bell (0)\n            SetPeqBand(buf, ch, 1, 0x7D80, 0x7366, 0x0A, 0x00);\n            // Band 2 (HM): +1.5 dB (0x8180) @ 3.2 kHz (0xBC14), Width 0x12, Bell (0)\n            SetPeqBand(buf, ch, 2, 0x8180, 0xBC14, 0x12, 0x00);\n            // Band 3 (HF): +2.0 dB (0x8200) @ 9.0 kHz (0xE27E), Width 0x10, Shelf (1)\n            SetPeqBand(buf, ch, 3, 0x8200, 0xE27E, 0x10, 0x01);\n            buf[baseOff + 0x0AD] = 0x01;\n\n            // Compressor: Threshold -16 dB (0x7000), Makeup +2.5 dB (0x8280), Comp ON (+0x12C = 1)\n            WriteU16(buf, baseOff + 0x0FA, 0x7000);\n            WriteU16(buf, baseOff + 0x0FC, 0x8280);\n            buf[baseOff + 0x12C] = 0x01;\n\n            // Routing:\n            // Main LR (Route 32): 0.0 dB (0x8000), Center (0x0025), Post-Fader Assigned (0xFE)\n            SetRoute(buf, ch, 32, 0x8000, 0x0025, 0xFE);\n            // FX 1 Send (Route 35): -10.0 dB (0x7600), Center (0x0025), Post-Fader Assigned (0xFE)\n            SetRoute(buf, ch, 35, 0x7600, 0x0025, 0xFE);\n\n            // Aux 1..4 (Routes 16..19): Pre-Fader Assigned (0xFF), \"More Me\" headphone mix\n            for (int aux = 0; aux < 4; aux++) {\n                ushort sendLvl = (aux == ch || aux == 3) ? (ushort)0x8000 : (ushort)0x7C00; // 0.0 dB own mic & Casque 4, -4.0 dB others\n                SetRoute(buf, ch, 16 + aux, sendLvl, 0x0025, 0xFF);\n            }\n        }\n\n        // 2. Configure Channels 88..91 (Aux 1..4 -> Casq 1..4)\n        string[] auxNames = { \"Casq 1\", \"Casq 2\", \"Casq 3\", \"Casq 4\" };\n        byte[] auxColors = { 3, 3, 3, 4 }; // Green for 1..3, Cyan for 4\n        for (int aux = 0; aux < 4; aux++) {\n            int ch = 88 + aux;\n            int baseOff = 0x0374 + ch * 0x150;\n            SetNameAndColor(buf, ch, auxNames[aux], auxColors[aux]);\n\n            // PEQ on headphone buses: LF +1.5 dB @ 80 Hz Shelf, HM -1.5 dB @ 3.5 kHz Bell (anti-fatigue)\n            SetPeqBand(buf, ch, 0, 0x8180, 0x3360, 0x10, 0x01);\n            SetPeqBand(buf, ch, 2, 0x7E80, 0xBE80, 0x10, 0x00);\n            buf[baseOff + 0x0AD] = 0x01;\n\n            // Safety Limiter on headphone buses: Fast attack (0x1000), Threshold -3.0 dB (0x7D00), Gain 0 dB (0x8000), Ratio 20:1 (0x3E), Comp ON\n            WriteU16(buf, baseOff + 0x0F4, 0x1000);\n            WriteU16(buf, baseOff + 0x0FA, 0x7D00);\n            WriteU16(buf, baseOff + 0x0FC, 0x8000);\n            buf[baseOff + 0x12A] = 0x3E;\n            buf[baseOff + 0x12C] = 0x01;\n\n            // Master Fader (Route 32) at 0.0 dB (0x8000)\n            SetRoute(buf, ch, 32, 0x8000, 0x0025, 0xFE);\n        }\n\n        // 3. Configure Channel 64 (FX1 Return -> Reverb)\n        SetNameAndColor(buf, 64, \"Reverb\", 6); // Purple\n        SetRoute(buf, 64, 32, 0x7A00, 0x0025, 0xFE); // -6.0 dB to Main LR\n        for (int aux = 0; aux < 4; aux++) {\n            SetRoute(buf, 64, 16 + aux, 0x7400, 0x0025, 0xFF); // -12.0 dB Pre-Fader to Casque 1..4\n        }\n\n        // 4. Configure Channel 104 (Main LR) & Channel 107 (FX1 Send)\n        SetNameAndColor(buf, 104, \"MainLR\", 1); // Red\n        SetNameAndColor(buf, 107, \"FX1Snd\", 6); // Purple\n\n        // 5. Configure Surface Layer A (offset 0x0068: 0xFF followed by 32 strips of 3 bytes)\n        int layerA = 0x0068;\n        buf[layerA] = 0xFF;\n        byte[,] stripsA = new byte[12, 3] {\n            { 1, 0, 0 },   // Strip 1: Voix 1 (Ip 1)\n            { 1, 1, 0 },   // Strip 2: Voix 2 (Ip 2)\n            { 1, 2, 0 },   // Strip 3: Voix 3 (Ip 3)\n            { 0, 0, 0 },   // Strip 4: Blank\n            { 1, 88, 0 },  // Strip 5: Casq 1 (Aux 1)\n            { 1, 89, 0 },  // Strip 6: Casq 2 (Aux 2)\n            { 1, 90, 0 },  // Strip 7: Casq 3 (Aux 3)\n            { 1, 91, 0 },  // Strip 8: Casq 4 (Aux 4)\n            { 0, 0, 0 },   // Strip 9: Blank\n            { 1, 64, 0 },  // Strip 10: Reverb (FX1 Ret)\n            { 1, 107, 0 }, // Strip 11: FX1Snd (FX1 Send)\n            { 1, 104, 0 }  // Strip 12: MainLR (Main LR)\n        };\n        for (int s = 0; s < 32; s++) {\n            int sOff = layerA + 1 + s * 3;\n            if (s < 12) {\n                buf[sOff]     = stripsA[s, 0];\n                buf[sOff + 1] = stripsA[s, 1];\n                buf[sOff + 2] = stripsA[s, 2];\n            } else {\n                buf[sOff]     = 0;\n                buf[sOff + 1] = 0;\n                buf[sOff + 2] = 0;\n            }\n        }\n\n        // 6. Compute CRC-32 over 0x14 .. 0x1FFFB using the table from SQ MixPad.exe\n        byte[] exe = File.ReadAllBytes(exePath);\n        uint[] table = new uint[256];\n        Buffer.BlockCopy(exe, 0x28D720, table, 0, 1024);\n\n        uint crc = 0;\n        for (int i = 0x14; i < 0x1FFFC; i++) {\n            crc = ~crc;\n            uint idx = (crc ^ buf[i]) & 0xFF;\n            crc = (crc >> 8) ^ table[idx];\n            crc = ~crc;\n        }\n        byte[] crcBytes = BitConverter.GetBytes(crc);\n        Array.Copy(crcBytes, 0, buf, 0x1FFFC, 4);\n\n        // 7. Create 17-byte SHOW.DAT (\"3Voix 4Casques\")\n        byte[] showDat = new byte[17];\n        byte[] showName = Encoding.ASCII.GetBytes(\"3Voix 4Casques\");\n        Array.Copy(showName, 0, showDat, 0, Math.Min(showName.Length, 16));\n\n        // 8. Write to all target directories\n        foreach (string dir in outputDirs) {\n            Directory.CreateDirectory(dir);\n            File.WriteAllBytes(Path.Combine(dir, \"NVDATA.DAT\"), buf);\n            File.WriteAllBytes(Path.Combine(dir, \"SHOW.DAT\"), showDat);\n            Console.WriteLine(\"Wrote SHOW.DAT & NVDATA.DAT (CRC=0x\" + crc.ToString(\"X8\") + \") to: \" + dir);\n        }\n    }\n}\n\"@\nAdd-Type -TypeDefinition $code -Language CSharp\n\n$template = \"C:\\Users\\brazi\\.gemini\\antigravity-cli\\brain\\7c40d475-4f8e-4ff9-9d8a-99008f2e1cda\\SQ5.DAT\"\n$exe = \"C:\\Program Files\\Allen & Heath\\SQ MixPad 1.6.1\\SQ MixPad.exe\"\n$usbRoot = \"C:\\Users\\brazi\\Desktop\\AHSQ\"\n$showDirUsb = Join-Path $usbRoot \"SHOWS\\SHOW0000\"\n$currentShowDir = \"C:\\Users\\brazi\\AppData\\Local\\Allen & Heath\\SQ-MixPad V1.6.1 - Rev. 92418\\CurrentShow\"\n\n# Create full AHSQ USB directory structure\nNew-Item -ItemType Directory -Force -Path (Join-Path $usbRoot \"SHOWS\\SHOW0000\") | Out-Null\nNew-Item -ItemType Directory -Force -Path (Join-Path $usbRoot \"SCENES\") | Out-Null\nNew-Item -ItemType Directory -Force -Path (Join-Path $usbRoot \"LIBRARY\") | Out-Null\n\n[SqShowBuilder]::Build($template, $exe, @($showDirUsb, $currentShowDir))\n","WaitMsBeforeAsync":5000,"toolSummary":"Generate SQ-5 Showfile and CurrentShow"}}]}
